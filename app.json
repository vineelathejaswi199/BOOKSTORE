{
  "expo": {
    "name": "PageTurn Bookstore",
    "slug": "eCommerce-bookstore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pageturn.bookstore"
    },
    "android": {
      "package": "com.pageturn.bookstore",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
